# Compose ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
TRANSLATOR_PORT=8001
POSTGRES_PORT=5433
REDIS_PORT_HOST=6380

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fbxviewer

# Runtime asset locations on the host
SMPLERX_OUTPUT_HOST=./runtime/smplerx
AMASS_OUTPUT_HOST=./runtime/amass
FBX_OUTPUT_HOST=./runtime/fbx
MODELS_HOST=./models

# Translator behavior
TRANSLATOR_STRICT=true

# Optional SMPLer-X asset-generation service
SMPLERX_IMAGE=aduy2408/smpler_x:latest
SMPLERX_PRETRAINED_HOST=./services/smplerx/pretrained_models
SMPLERX_INPUT_HOST=./runtime/input_videos
PRETRAINED_MODEL=smpler_x_s32
